<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="spatial_perception_demo">
    <!-- Global Light Source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Standing person for the static world model demo. A plain box is not a COCO class, so
         YOLOv8 never reports it. stand.dae ships with Gazebo, so no model download is needed. -->
    <actor name="standing_person">
      <pose>2.5 -2.4 0 0 0 3.14</pose>
      <skin>
        <filename>stand.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="standing">
        <filename>stand.dae</filename>
        <scale>1.0</scale>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="standing">
          <waypoint>
            <time>0</time>
            <pose>2.5 -2.4 0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>10</time>
            <pose>2.5 -2.4 0 0 0 3.14</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Animated Walking Human Actor for Dynamic Kinematics Demo -->
    <actor name="walking_human">
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <!-- Waypoint 1: Walking left to right across robot front field of view -->
          <waypoint>
            <time>0.0</time>
            <pose>2.5 -1.5 0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>4.0</time>
            <pose>2.5 1.5 0 0 0 1.5708</pose>
          </waypoint>
          <!-- Waypoint 2: Turn around and walk back -->
          <waypoint>
            <time>4.5</time>
            <pose>2.5 1.5 0 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>8.5</time>
            <pose>2.5 -1.5 0 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>9.0</time>
            <pose>2.5 -1.5 0 0 0 1.5708</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>

